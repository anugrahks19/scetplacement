+        const codingContainer = document.getElementById('codingOptionsContainer');
+
+        if (type === 'MCQ') {
+            mcqContainer.classList.remove('d-none');
+            codingContainer.classList.add('d-none');
+        } else {
+            mcqContainer.classList.add('d-none');
+            codingContainer.classList.remove('d-none');
+        }
+    });
+
+    // Save Question Logic
+    document.getElementById('btnSaveQuestion').addEventListener('click', async function() {
+        const btn = this;
+        const originalText = btn.innerHTML;
+        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
+        btn.disabled = true;
+
+        const title = document.getElementById('qTitle').value;
+        const type = document.getElementById('qType').value;
+        const difficulty = document.getElementById('qDiff').value;
+        const topicId = document.getElementById('qTopic').value;
+        const contentText = document.getElementById('qContent').value;
+        
+        let finalContent = { text: contentText };
+
+        if (type === 'MCQ') {
+            finalContent.options = [
+                document.getElementById('qOptionA').value,
+                document.getElementById('qOptionB').value,
+                document.getElementById('qOptionC').value,
+                document.getElementById('qOptionD').value
+            ];
+            finalContent.correctOptionIndex = parseInt(document.getElementById('qCorrectOption').value);
+        } else {
+            finalContent.starterCode = document.getElementById('qStarterCode').value;
+            finalContent.testCases = [
+                { input: document.getElementById('qInput').value, output: document.getElementById('qOutput').value }
+            ];
+        }
+
+        const query = `
+            mutation CreateQuestion($input: CreateQuestionInput!) {
+                createQuestion(input: $input) {
+                    id
+                    title
+                }
+            }
+        `;
+
+        const variables = {
+            input: {
+                title,
+                content: JSON.stringify(finalContent),
+                type,
+                difficulty,
+                topicId,
+                categoryId: "cat_1"
+            }
+        };
+
+        try {
+            await graphqlRequest(query, variables);
+            alert('Question saved successfully into College Repository!');
+            window.location.href = 'faculty-questions.html';
+        } catch (error) {
+            alert('Error saving question: ' + error.message);
+        } finally {
+            btn.innerHTML = originalText;
+            btn.disabled = false;
+        }
+    });
+
+    // AI Generation Logic (NotebookLLM Style)
+    document.getElementById('btnGenerateAi').addEventListener('click', async function() {
+        const btn = this;
+        const sourceContext = document.getElementById('aiSourceContext').value;
+        
+        if (!sourceContext.trim()) {
+            alert("Please paste some source material first!");
+            return;
+        }
+
+        const originalText = btn.innerHTML;
+        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Generating...';
+        btn.disabled = true;
+
+        const query = `
+            mutation GenerateQuestions($topic: String!, $count: Int!, $difficulty: String!, $sourceContext: String) {
+                generateQuestionsWithAi(topic: $topic, count: $count, difficulty: $difficulty, sourceContext: $sourceContext) {
+                    title
+                    content
+                    type
+                    difficulty
+                }
+            }
+        `;
+
+        const variables = {
+            topic: document.getElementById('qTopic').options[document.getElementById('qTopic').selectedIndex].text || 'General',
+            count: 1,
+            difficulty: document.getElementById('qDiff').value || 'MEDIUM',
+            sourceContext: sourceContext,
+            type: document.getElementById('qType').value
+        };
+
+        try {
+            const result = await graphqlRequest(query, variables);
+            const generated = result.generateQuestionsWithAi[0];
+            
+            if (generated) {
+                document.getElementById('qTitle').value = generated.title || '';
+                
+                let textContent = generated.content;
+                let parsedContent = {};
+                if (typeof textContent === 'object') {
+                    parsedContent = textContent;
+                    textContent = textContent.text;
+                } else if (typeof textContent === 'string' && textContent.startsWith('{')) {
+                    try { 
+                        parsedContent = JSON.parse(textContent);
+                        textContent = parsedContent.text || parsedContent.questionText || textContent; 
+                    } catch(e) {}
+                }
+                
+                document.getElementById('qContent').value = textContent || '';
+                
+                // If it generated MCQ options, populate them
+                if (parsedContent.options && parsedContent.options.length >= 4) {
+                    document.getElementById('qType').value = 'MCQ';
+                    document.getElementById('qType').dispatchEvent(new Event('change'));
+                    document.getElementById('qOptionA').value = parsedContent.options[0] || '';
+                    document.getElementById('qOptionB').value = parsedContent.options[1] || '';
+                    document.getElementById('qOptionC').value = parsedContent.options[2] || '';
+                    document.getElementById('qOptionD').value = parsedContent.options[3] || '';
+                    document.getElementById('qCorrectOption').value = parsedContent.correctOptionIndex || 0;
+                } else {
+                    document.getElementById('qType').value = generated.type || 'CODING';
+                    document.getElementById('qType').dispatchEvent(new Event('change'));
+                    
+                    if (parsedContent.starterCode) {
+                        document.getElementById('qStarterCode').value = parsedContent.starterCode;
+                    }
+                    if (parsedContent.testCases && parsedContent.testCases.length > 0) {
+                        document.getElementById('qInput').value = parsedContent.testCases[0].input || '';
+                        document.getElementById('qOutput').value = parsedContent.testCases[0].output || '';
+                    }
+                }
+                
+                document.getElementById('qDiff').value = generated.difficulty || 'MEDIUM';
+            }
+        } catch (error) {
+            alert('Error generating question with AI: ' + error.message);
+        } finally {
+            btn.innerHTML = originalText;
+            btn.disabled = false;
+        }
+    });
+</script>
+</body>
+</html>
