+
+<!-- Scripts -->
+<script src="assets/vendor/jquery/jquery.min.js"></script>
+<script src="assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>
+<script src="assets/js/api.js"></script>
+<script src="assets/js/app.js"></script>
+<script>
+    document.getElementById('themeToggle')?.addEventListener('click', function () {
+        const html = document.documentElement;
+        const currentTheme = html.getAttribute('data-bs-theme');
+        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
+        html.setAttribute('data-bs-theme', newTheme);
+    });
+
+    function filterQuestions() {
+        const type = document.getElementById('typeFilter').value;
+        const diff = document.getElementById('diffFilter').value;
+        const dept = document.getElementById('deptSelector').value;
+        const sem = document.getElementById('semSelector').value;
+        const q = (document.getElementById('tableSearch')?.value || '').toLowerCase();
+
+        const rows = document.querySelectorAll('#questionsTable tbody tr');
+        let visibleCount = 0;
+
+        rows.forEach(row => {
+            const rowType = row.getAttribute('data-type');
+            const rowDiff = row.getAttribute('data-diff');
+            const rowDept = row.getAttribute('data-dept');
+            const rowSem = row.getAttribute('data-sem');
+            const rowText = row.innerText.toLowerCase();
+
+            const matchType = (type === 'all' || rowType === type);
+            const matchDiff = (diff === 'all' || rowDiff === diff);
+            const matchDept = (!rowDept || rowDept === dept); // Mock matching
+            const matchSem = (!rowSem || rowSem === sem); // Mock matching
+            const matchSearch = (!q || rowText.includes(q));
+
+            if (matchType && matchDiff && matchDept && matchSem && matchSearch) {
+                row.style.display = '';
+                visibleCount++;
+            } else {
+                row.style.display = 'none';
+            }
+        });
+
+        document.getElementById('questionCountText').innerText = `Showing ${visibleCount} questions in repository`;
+    }
+
+    function resetFilters() {
+        document.getElementById('typeFilter').value = 'all';
+        document.getElementById('diffFilter').value = 'all';
+        document.getElementById('deptSelector').value = 'CSE';
+        document.getElementById('semSelector').value = 'Sem 7';
+        if (document.getElementById('tableSearch')) document.getElementById('tableSearch').value = '';
+        filterQuestions();
+    }
+
+    async function loadQuestions() {
+        const query = `
+            query {
+                questions {
+                    id
+                    title
+                    content
+                    type
+                    difficulty
+                    status
+                    categoryId
+                    topicId
+                }
+            }
+        `;
+
+        try {
+            const data = await graphqlRequest(query);
+            const questions = data.questions;
+            const tbody = document.getElementById('questionsTableBody');
+            
+            if (questions.length === 0) {
+                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No questions found in repository.</td></tr>';
+                document.getElementById('questionCountText').innerText = 'Showing 0 questions in repository';
+                return;
+            }
+
+            tbody.innerHTML = '';
+            
+            questions.forEach(q => {
+                // Map Enums to Badges
+                const typeBadgeMap = {
+                    'MCQ': 'bg-info-subtle text-info',
+                    'CODING': 'bg-primary-subtle text-primary',
+                    'DEBUGGING': 'bg-danger-subtle text-danger'
+                };
+                
+                const diffBadgeMap = {
+                    'EASY': 'bg-success-subtle text-success',
+                    'MEDIUM': 'bg-warning-subtle text-warning',
+                    'HARD': 'bg-danger-subtle text-danger'
+                };
+
+                const statusBadgeMap = {
+                    'DRAFT': 'bg-secondary-subtle text-secondary',
+                    'PENDING_REVIEW': 'bg-warning-subtle text-warning',
+                    'APPROVED': 'bg-success-subtle text-success',
+                    'PUBLISHED': 'bg-success-subtle text-success',
+                    'RETIRED': 'bg-dark-subtle text-dark',
+                    'REJECTED': 'bg-danger-subtle text-danger'
+                };
+
+                const typeBadge = typeBadgeMap[q.type] || 'bg-secondary-subtle text-secondary';
+                const diffBadge = diffBadgeMap[q.difficulty] || 'bg-secondary-subtle text-secondary';
+                const statusBadge = statusBadgeMap[q.status] || 'bg-secondary-subtle text-secondary';
+
+                // We try to parse the content safely in case it's a JSON string or an object
+                let textContent = q.content;
+                if (typeof textContent === 'object' && textContent.text) textContent = textContent.text;
+                else if (typeof textContent === 'string' && textContent.startsWith('{')) {
+                    try { textContent = JSON.parse(textContent).text || textContent; } catch(e) {}
+                }
+                
+                // Truncate long content
+                if (textContent && textContent.length > 80) textContent = textContent.substring(0, 80) + '...';
+
+                // Assign mock dept/sem based on id for demo filtering
+                const depts = ['CSE', 'IT', 'ECE'];
+                const mockDept = depts[q.id.charCodeAt(0) % 3];
+                const mockSem = q.id.charCodeAt(1) % 2 === 0 ? 'Sem 7' : 'Sem 6';
+
+                const tr = document.createElement('tr');
+                tr.setAttribute('data-type', q.type);
+                tr.setAttribute('data-diff', q.difficulty);
+                tr.setAttribute('data-dept', mockDept);
+                tr.setAttribute('data-sem', mockSem);
+                
+                tr.innerHTML = `
+                    <td class="ps-4 fw-mono text-muted fs-12">#${q.id.substring(0,6).toUpperCase()}</td>
+                    <td>
+                        <div class="fw-semibold">${q.title}</div>
+                        <span class="small text-muted">${textContent || 'No description available'}</span>
+                    </td>
+                    <td>
+                        <span class="badge bg-secondary-subtle text-secondary rounded-pill mb-1">${q.topicId}</span><br>
+                        <span class="badge bg-light text-dark rounded-pill border" style="font-size:10px;">${mockDept} • ${mockSem}</span>
+                    </td>
+                    <td><span class="badge ${typeBadge} rounded-pill">${q.type}</span></td>
+                    <td><span class="badge ${diffBadge} rounded-pill">${q.difficulty}</span></td>
+                    <td><span class="badge ${statusBadge} rounded-pill">${q.status}</span></td>
+                    <td class="text-end pe-4">
+                        <a href="faculty-question-editor.html?id=${q.id}" class="btn btn-sm btn-light border rounded-pill px-2"><i class="bi bi-pencil"></i></a>
+                        <button class="btn btn-sm btn-light border rounded-pill px-2 text-danger" onclick="deleteQuestion('${q.id}')"><i class="bi bi-trash"></i></button>
+                    </td>
+                `;
+                tbody.appendChild(tr);
+            });
+
+            document.getElementById('questionCountText').innerText = `Showing ${questions.length} questions in repository`;
+        } catch (error) {
+            document.getElementById('questionsTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">Failed to load questions. Make sure the backend is running.</td></tr>';
+        }
+    }
+
+    async function generatePool() {
+        const btn = document.getElementById('generatePoolBtn');
+        const originalText = btn.innerHTML;
+        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Generating...';
+        btn.disabled = true;
+
+        const topic = document.getElementById('poolTopic').value;
+        const sourceContext = document.getElementById('poolSourceContext').value;
+        
+        const config = {
+            mcqEasy: parseInt(document.getElementById('poolMcqEasy').value) || 0,
+            mcqMedium: parseInt(document.getElementById('poolMcqMedium').value) || 0,
+            mcqHard: parseInt(document.getElementById('poolMcqHard').value) || 0,
+            codingEasy: 0,
+            codingMedium: parseInt(document.getElementById('poolCodingMedium').value) || 0,
+            codingHard: 0,
+            debuggingEasy: parseInt(document.getElementById('poolDebuggingEasy').value) || 0,
+            debuggingMedium: 0,
+            debuggingHard: 0
+        };
+
+        const query = `
+            mutation GeneratePool($topic: String!, $sourceContext: String!, $config: PoolGenerationConfig!) {
+                generateFullQuestionPoolWithAi(
+                    topic: $topic,
+                    sourceContext: $sourceContext,
+                    config: $config
+                )
+            }
+        `;
+
+        try {
+            const data = await graphqlRequest(query, { topic, sourceContext, config });
+            alert(`Successfully generated and saved ${data.generateFullQuestionPoolWithAi} questions!`);
+            
+            const modalEl = document.getElementById('generatePoolModal');
+            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
+            modal.hide();
+            
+            loadQuestions();
+        } catch (error) {
+            console.error('Error generating pool:', error);
+            alert('Failed to generate question pool.');
+        } finally {
+            btn.innerHTML = originalText;
+            btn.disabled = false;
+        }
+    }
+
+    async function deleteQuestion(id) {
+        if (!confirm('Are you sure you want to permanently delete this question?')) return;
+        const query = `mutation { deleteQuestion(id: "${id}") { id } }`;
+        try {
+            await graphqlRequest(query);
+            loadQuestions();
+        } catch (error) {
+            alert('Failed to delete question.');
+        }
+    }
+
+    function exportCSV() {
+        const rows = Array.from(document.querySelectorAll('#questionsTable tbody tr'))
+            .filter(row => row.style.display !== 'none' && row.querySelector('td'));
+        
+        if (rows.length === 0) {
+            alert("No data to export");
+            return;
+        }
+
+        let csv = 'ID,Question,Type,Difficulty,Status\\n';
+        rows.forEach(row => {
+            const cells = row.querySelectorAll('td');
+            const id = cells[0].innerText.trim();
+            const text = cells[1].querySelector('div').innerText.trim().replace(/"/g, '""');
+            const type = cells[3].innerText.trim();
+            const diff = cells[4].innerText.trim();
+            const status = cells[5].innerText.trim();
+            csv += `"${id}","${text}","${type}","${diff}","${status}"\\n`;
+        });
+
+        const blob = new Blob([csv], { type: 'text/csv' });
+        const url = window.URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        a.href = url;
+        a.download = 'question-bank.csv';
+        a.click();
+    }
+
+    // Load on start
+    document.addEventListener('DOMContentLoaded', loadQuestions);
+</script>
+</body>
+</html>
