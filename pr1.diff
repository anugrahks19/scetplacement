+        html.setAttribute('data-bs-theme', newTheme);
+    });
+
+    function updateContextBadge() {
+        const dept = document.getElementById('deptSelector').value.split(' ')[0];
+        const sem = document.getElementById('semSelector').value.split(' ')[1];
+        const cls = document.getElementById('classSelector').value.split(' ')[1];
+        
+        let deptLabel = dept;
+        if (document.getElementById('deptSelector').value.includes('ECE')) deptLabel = 'ECE';
+        else if (document.getElementById('deptSelector').value.includes('IT')) deptLabel = 'IT';
+        else if (document.getElementById('deptSelector').value.includes('CSE')) deptLabel = 'CSE';
+
+        document.getElementById('scopeBadge').innerHTML = `<i class="bi bi-check2-circle me-1"></i>Active: ${deptLabel}-${cls} (Sem ${sem})`;
+        const subtitle = document.getElementById('assessmentStatusSubtitle');
+        if (subtitle) {
+            subtitle.innerText = `Real-time status for ${deptLabel} - Division ${cls}`;
+        }
+    }
+
+    function addTask() {
+        const input = document.getElementById('newTaskInput');
+        if (!input.value.trim()) return;
