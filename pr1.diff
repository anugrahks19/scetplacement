new file mode 100644
index 0000000..fef4854
--- /dev/null
+++ b/backend/prisma/schema.prisma
@@ -0,0 +1,148 @@
+// This is your Prisma schema file,
+// learn more about it in the docs: https://pris.ly/d/prisma-schema
+
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "postgresql"
+  url      = env("DATABASE_URL")
+}
+
+model Question {
+  id              String           @id @default(cuid())
+  organizationId  String
+  categoryId      String
+  topicId         String
+  type            QuestionType
+  difficulty      Difficulty
+  status          QuestionStatus
+  title           String
+  content         Json
+  explanation     String?
+  tags            String[]
+  createdById     String
+  updatedById     String
+  version         Int              @default(1)
+  createdAt       DateTime         @default(now())
+  updatedAt       DateTime         @updatedAt
+  publishedAt     DateTime?
+
+  testCases       TestCase[]
+  assessmentItems AssessmentItem[]
+  reviewLogs      QuestionReviewLog[]
+
+  @@index([organizationId, status])
+  @@index([categoryId, topicId])
+  @@index([createdById])
+}
+
+model TestCase {
+  id          String   @id @default(cuid())
+  questionId  String
+  input       String
+  output      String
+  isHidden    Boolean  @default(true)
+  question    Question @relation(fields: [questionId], references: [id])
+}
+
+model QuestionReviewLog {
+  id          String       @id @default(cuid())
+  questionId  String
+  reviewedBy  String
+  action      ReviewAction
+  feedback    String?
+  createdAt   DateTime     @default(now())
+  question    Question     @relation(fields: [questionId], references: [id])
+}
+
+model Assessment {
+  id                     String           @id @default(cuid())
+  organizationId         String
+  title                  String
+  description            String?
+  status                 AssessmentStatus
+  createdById            String
+  startsAt               DateTime?
+  endsAt                 DateTime?
+  durationMinutes        Int
+  totalMarks             Int
+  negativeMarkingEnabled Boolean          @default(false)
+  attemptLimit           Int              @default(1)
+  randomizeQuestions     Boolean          @default(false)
+  randomizeOptions       Boolean          @default(false)
+  publishedAt            DateTime?
+  createdAt              DateTime         @default(now())
+  updatedAt              DateTime         @updatedAt
+
+  sections  AssessmentSection[]
+  batches   AssessmentBatch[]
+
+  @@index([organizationId, status])
+  @@index([startsAt, endsAt])
+}
+
+model AssessmentSection {
+  id            String   @id @default(cuid())
+  assessmentId  String
+  name          String
+  order         Int
+  items         AssessmentItem[]
+  assessment    Assessment @relation(fields: [assessmentId], references: [id])
+}
+
+model AssessmentItem {
+  id          String   @id @default(cuid())
+  sectionId   String
+  questionId  String
+  marks       Int
+  order       Int
+  section     AssessmentSection @relation(fields: [sectionId], references: [id])
+  question    Question          @relation(fields: [questionId], references: [id])
+
+  @@unique([sectionId, questionId])
+}
+
+model AssessmentBatch {
+  id           String  @id @default(cuid())
+  assessmentId String
+  batchId      String
+  assessment   Assessment @relation(fields: [assessmentId], references: [id])
+}
+
+enum QuestionType {
+  MCQ
+  CODING
+  DEBUGGING
+}
+
+enum Difficulty {
+  EASY
+  MEDIUM
+  HARD
+}
+
+enum QuestionStatus {
+  DRAFT
+  PENDING_REVIEW
+  APPROVED
+  PUBLISHED
+  RETIRED
+  REJECTED
+}
+
+enum AssessmentStatus {
+  DRAFT
+  SCHEDULED
+  PUBLISHED
+  CLOSED
+  ARCHIVED
+}
+
+enum ReviewAction {
+  SUBMITTED
+  APPROVED
+  REJECTED
+  REVISION_REQUESTED
+}
