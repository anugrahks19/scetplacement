+            const data = await graphqlRequest(query);
+            const questions = data.questions || [];
+            const container = document.getElementById('reviewContainer');
+            
+            document.getElementById('pendingCountBadge').innerText = `${questions.length} Pending Approval`;
+            document.getElementById('headerPendingCount').innerText = `${questions.length} Awaiting Review`;
+
+            if (questions.length === 0) {
+                container.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-check-circle fs-1 text-success mb-3 d-block"></i>Queue is empty! All caught up.</div>';
+                return;
+            }
+
+            container.innerHTML = '';
+            questions.forEach((q, idx) => {
+                const borderClass = idx === questions.length - 1 ? '' : 'border-bottom';
+                
+                let textContent = q.content;
+                if (typeof textContent === 'object' && textContent.text) textContent = textContent.text;
+                else if (typeof textContent === 'string' && textContent.startsWith('{')) {
+                    try { textContent = JSON.parse(textContent).text || textContent; } catch(e) {}
+                }
+                if (textContent && textContent.length > 150) textContent = textContent.substring(0, 150) + '...';
+
+                const date = new Date(Number(q.createdAt) || q.createdAt).toLocaleString();
+
+                const item = document.createElement('div');
+                item.className = `list-group-item px-0 py-3 ${borderClass}`;
+                item.innerHTML = `
+                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
+                        <div>
+                            <span class="badge bg-primary-subtle text-primary rounded-pill me-1">${q.type}</span>
+                            <span class="badge bg-danger-subtle text-danger rounded-pill me-1">${q.difficulty}</span>
+                            <span class="badge bg-success-subtle text-success rounded-pill">AI Generated</span>
+                        </div>
+                        <span class="small text-muted text-nowrap">Generated: ${date}</span>
+                    </div>
+                    <h5 class="fw-bold mb-2">${q.title}</h5>
+                    <p class="text-muted small mb-3">${textContent || 'No content preview.'}</p>
+                    <div class="d-flex gap-2">
+                        <button class="btn btn-sm btn-success rounded-pill px-3" onclick="approveQuestion('${q.id}', this)"><i class="bi bi-check-lg me-1"></i>Approve Question</button>
+                        <a href="faculty-question-editor.html?id=${q.id}" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-pencil me-1"></i>Edit Question</a>
+                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="rejectQuestion('${q.id}', this)"><i class="bi bi-trash me-1"></i>Reject</button>
+                    </div>
+                `;
+                container.appendChild(item);
+            });
+        } catch (e) {
+            document.getElementById('reviewContainer').innerHTML = '<div class="text-center py-4 text-danger">Failed to load queue.</div>';
+        }
+    }
+
+    async function approveQuestion(id, btn) {
+        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
+        btn.disabled = true;
+        try {
+            await graphqlRequest(`mutation { approveQuestion(id: "${id}", feedback: "Approved") { id } }`);
+            btn.innerHTML = '<i class="bi bi-check2"></i> Approved';
+            btn.classList.replace('btn-success', 'btn-outline-success');
+            setTimeout(() => { btn.closest('.list-group-item').remove(); updateCounts(-1); }, 1000);
+        } catch (e) {
+            btn.innerHTML = 'Error';
+            btn.disabled = false;
+        }
+    }
+
+    async function rejectQuestion(id, btn) {
+        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
+        btn.disabled = true;
+        try {
+            await graphqlRequest(`mutation { rejectQuestion(id: "${id}", feedback: "Rejected") { id } }`);
+            btn.closest('.list-group-item').remove();
+            updateCounts(-1);
+        } catch (e) {
+            btn.innerHTML = 'Error';
+            btn.disabled = false;
+        }
+    }
+
+    function updateCounts(change) {
+        const badge = document.getElementById('pendingCountBadge');
+        const header = document.getElementById('headerPendingCount');
+        let current = parseInt(badge.innerText);
+        if (isNaN(current)) return;
+        current += change;
+        if (current < 0) current = 0;
+        badge.innerText = `${current} Pending Approval`;
+        header.innerText = `${current} Awaiting Review`;
+    }
+
+    document.addEventListener('DOMContentLoaded', loadPendingQuestions);
+</script>
+</body>
+</html>
